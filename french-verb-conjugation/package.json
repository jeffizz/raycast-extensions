{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "french-verbs",
  "title": "French Verbs",
  "description": "Look up and practice French conjugations",
  "icon": "icon.png",
  "author": "jianfeng",
  "categories": ["Education"],
  "license": "MIT",
  "commands": [
    {
      "name": "lookup",
      "title": "Conjugate",
      "description": "Show a French verb's conjugation",
      "mode": "view",
      "subtitle": "Français",
      "icon": "icon.png"
    },
    {
      "name": "practice",
      "title": "Practice",
      "description": "Fill in a French conjugation and check it",
      "mode": "view",
      "subtitle": "Français",
      "icon": "icon.png"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "lint": "ray lint"
  }
}
